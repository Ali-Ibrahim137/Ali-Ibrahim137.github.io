---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
{%- assign visible_posts = site.posts | where_exp: "post", "post.isVisible == true" -%}
{%- assign newest_post = visible_posts | first -%}
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | strip_html | normalize_whitespace | xml_escape }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html"/>
  <id>{{ '/' | absolute_url }}</id>
  <updated>{{ newest_post.date | default: site.time | date_to_xmlschema }}</updated>
  <author>
    <name>{{ site.author | default: site.title | xml_escape }}</name>
    {%- if site.email %}
    <email>{{ site.email | xml_escape }}</email>
    {%- endif %}
  </author>
  <generator uri="https://jekyllrb.com/">Jekyll</generator>

  {%- for post in visible_posts limit: 20 %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html" title="{{ post.title | xml_escape }}"/>
    <id>{{ post.id | absolute_url }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    {%- if post.categories %}
    {%- for category in post.categories %}
    <category term="{{ category | xml_escape }}"/>
    {%- endfor %}
    {%- endif %}
    <summary type="html">{{ post.excerpt | strip | xml_escape }}</summary>
    <content type="html">{{ post.content | strip | xml_escape }}</content>
  </entry>
  {%- endfor %}
</feed>
